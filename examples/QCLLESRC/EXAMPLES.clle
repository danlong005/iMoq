/* ---------------------------------------------------------------- */
/* EXAMPLES - Run every iMoq feature example                        */
/*                                                                  */
/*   CRTBNDCL PGM(IMOQ/EXAMPLES) SRCFILE(IMOQ/QCLLESRC)             */
/*   CALL IMOQ/EXAMPLES PARM('IMOQ')                                */
/*                                                                  */
/* Compiles and calls each example's driver, then reports "ok" or   */
/* "FAIL" for each one as a diagnostic message.                     */
/* ---------------------------------------------------------------- */
             PGM        PARM(&LIB)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&EX) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSG) TYPE(*CHAR) LEN(512)
             DCL        VAR(&FAILS) TYPE(*INT) LEN(4)
             DCL        VAR(&NBR) TYPE(*CHAR) LEN(12)

             CHGJOB     INQMSGRPY(*DFT)

             CHGVAR     VAR(&EX) VALUE('EXPGM')
             CALLSUBR   SUBR(RUN)
             CHGVAR     VAR(&EX) VALUE('EXRETURN')
             CALLSUBR   SUBR(RUN)
             CHGVAR     VAR(&EX) VALUE('EXMATCH')
             CALLSUBR   SUBR(RUN)
             CHGVAR     VAR(&EX) VALUE('EXNEWEST')
             CALLSUBR   SUBR(RUN)
             CHGVAR     VAR(&EX) VALUE('EXSERIES')
             CALLSUBR   SUBR(RUN)
             CHGVAR     VAR(&EX) VALUE('EXTIMES')
             CALLSUBR   SUBR(RUN)
             CHGVAR     VAR(&EX) VALUE('EXTHROW')
             CALLSUBR   SUBR(RUN)
             CHGVAR     VAR(&EX) VALUE('EXSTRICT')
             CALLSUBR   SUBR(RUN)
             CHGVAR     VAR(&EX) VALUE('EXVERIFY')
             CALLSUBR   SUBR(RUN)
             CHGVAR     VAR(&EX) VALUE('EXNOMORE')
             CALLSUBR   SUBR(RUN)
             CHGVAR     VAR(&EX) VALUE('EXCAPT')
             CALLSUBR   SUBR(RUN)
             CHGVAR     VAR(&EX) VALUE('EXOMIT')
             CALLSUBR   SUBR(RUN)
             CHGVAR     VAR(&EX) VALUE('EXRESET')
             CALLSUBR   SUBR(RUN)
             CHGVAR     VAR(&EX) VALUE('EXERRMSG')
             CALLSUBR   SUBR(RUN)
             CHGVAR     VAR(&EX) VALUE('EXCL')
             CALLSUBR   SUBR(RUN)
             CHGVAR     VAR(&EX) VALUE('EXAPI')
             CALLSUBR   SUBR(RUN)

             IF         COND(&FAILS *GT 0) THEN(DO)
             CHGVAR     VAR(&NBR) VALUE(%CHAR(&FAILS))
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA('EXAMPLES: +
                          ' *CAT %TRIM(&NBR) *BCAT 'example(s) +
                          failed') MSGTYPE(*ESCAPE)
             ENDDO
             SNDPGMMSG  MSGID(CPF9897) MSGF(QCPFMSG) MSGDTA('EXAMPLES: +
                          all examples passed') MSGTYPE(*COMP)
             RETURN

/* ---- compile and call one driver --------------------------------- */
             SUBR       SUBR(RUN)
             CRTBNDCL   PGM(&LIB/&EX) SRCFILE(&LIB/QCLLESRC) +
                          SRCMBR(&EX) REPLACE(*YES)
             MONMSG     MSGID(CPF0000) EXEC(DO)
             CHGVAR     VAR(&MSG) VALUE('driver did not compile')
             CALLSUBR   SUBR(FAILED)
             RTNSUBR
             ENDDO
             CALL       PGM(&LIB/&EX) PARM(&LIB)
             MONMSG     MSGID(CPF0000 IMQ0000 MCH0000 CEE0000 +
                          RNX0000 RNS0000) EXEC(DO)
             RCVMSG     MSGTYPE(*EXCP) RMV(*YES) MSG(&MSG)
             CALLSUBR   SUBR(FAILED)
             RTNSUBR
             ENDDO
             SNDPGMMSG  MSGID(CPF9897) MSGF(QCPFMSG) MSGDTA('ok   ' +
                          *CAT &EX) MSGTYPE(*DIAG)
             ENDSUBR

             SUBR       SUBR(FAILED)
             SNDPGMMSG  MSGID(CPF9897) MSGF(QCPFMSG) MSGDTA('FAIL ' +
                          *CAT &EX *BCAT '-' *BCAT &MSG) MSGTYPE(*DIAG)
             CHGVAR     VAR(&FAILS) VALUE(&FAILS + 1)
             ENDSUBR
             ENDPGM
