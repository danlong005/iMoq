/* ---------------------------------------------------------------- */
/* EXUNUSED - Find stubs that no call used                          */
/*                                                                  */
/* Driver for test program EXUNUSED_T.                              */
/*   CRTBNDCL PGM(IMOQ/EXUNUSED) SRCFILE(IMOQ/QCLLESRC)             */
/*   CALL IMOQ/EXUNUSED PARM('IMOQ')                                */
/* ---------------------------------------------------------------- */
             PGM        PARM(&LIB)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSG) TYPE(*CHAR) LEN(512)

/* iMoq and the example source are in &LIB                          */
             CHGCURLIB  CURLIB(&LIB)

/* 1. Create the mocks                                              */
             IMOQPGM    OBJ(EXCUST) PARMS((*CHAR 5) (*CHAR 30) (*IND))
             IMOQSRVPGM OBJ(EXPRICE)
             IMOQPROC   OBJ(EXPRICE) PROC(EX_PRICE) +
                          RTNTYPE(*PACKED 7 2) PARMS((*CHAR 5 *CONST))
             IMOQBUILD  OBJ(EXPRICE)

/* 2. Compile the test program                                      */
             CRTRPGMOD  MODULE(QTEMP/EXUNUSED_T) SRCFILE(&LIB/QRPGLESRC)
             CRTPGM     PGM(QTEMP/EXUNUSED_T) MODULE(QTEMP/EXUNUSED_T) +
                          BNDSRVPGM((*LIBL/EXPRICE) (*LIBL/IMOQENG)) +
                          ACTGRP(*NEW)

/* 3. Run it. A failed expect() arrives as escape message CPF9898.  */
             CALL       PGM(QTEMP/EXUNUSED_T)
             MONMSG     MSGID(CPF9898) EXEC(DO)
             RCVMSG     MSGTYPE(*EXCP) MSG(&MSG)
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA('EXUNUSED +
                          failed:' *BCAT &MSG) MSGTYPE(*ESCAPE)
             ENDDO

/* 4. Remove the mocks                                              */
             IMOQRMV
             SNDPGMMSG  MSGID(CPF9897) MSGF(QCPFMSG) MSGDTA('EXUNUSED +
                          passed') MSGTYPE(*COMP)
             ENDPGM
