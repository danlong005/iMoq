/* ---------------------------------------------------------------- */
/* EXVALUE - Parameters passed by value                             */
/*                                                                  */
/* Driver for test program EXVALUE_T.                               */
/*   CRTBNDCL PGM(IMOQ/EXVALUE) SRCFILE(IMOQ/QCLLESRC)              */
/*   CALL IMOQ/EXVALUE PARM('IMOQ')                                 */
/* ---------------------------------------------------------------- */
             PGM        PARM(&LIB)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSG) TYPE(*CHAR) LEN(512)

/* iMoq and the example source are in &LIB                          */
             CHGCURLIB  CURLIB(&LIB)

/* 1. Create the mock. *VALUE goes where the passing style goes.    */
             IMOQSRVPGM OBJ(EXCALC)
             IMOQPROC   OBJ(EXCALC) PROC(EX_ROUND) +
                          RTNTYPE(*PACKED 9 2) +
                          PARMS((*PACKED 9 2 *VALUE) (*INT 10 0 +
                          *VALUE))
             IMOQBUILD  OBJ(EXCALC)

/* 2. Compile the test program                                      */
             CRTRPGMOD  MODULE(QTEMP/EXVALUE_T) SRCFILE(&LIB/QRPGLESRC)
             CRTPGM     PGM(QTEMP/EXVALUE_T) MODULE(QTEMP/EXVALUE_T) +
                          BNDSRVPGM((*LIBL/EXCALC) (*LIBL/IMOQENG)) +
                          ACTGRP(*NEW)

/* 3. Run it. A failed expect() arrives as escape message CPF9898.  */
             CALL       PGM(QTEMP/EXVALUE_T)
             MONMSG     MSGID(CPF9898) EXEC(DO)
             RCVMSG     MSGTYPE(*EXCP) MSG(&MSG)
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA('EXVALUE +
                          failed:' *BCAT &MSG) MSGTYPE(*ESCAPE)
             ENDDO

/* 4. Remove the mocks                                              */
             IMOQRMV
             SNDPGMMSG  MSGID(CPF9897) MSGF(QCPFMSG) MSGDTA('EXVALUE +
                          passed') MSGTYPE(*COMP)
             ENDPGM
