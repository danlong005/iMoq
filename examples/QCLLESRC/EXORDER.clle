/* ---------------------------------------------------------------- */
/* EXORDER - Check the order of calls                               */
/*                                                                  */
/* Driver for test program EXORDER_T.                               */
/*   CRTBNDCL PGM(IMOQ/EXORDER) SRCFILE(IMOQ/QCLLESRC)              */
/*   CALL IMOQ/EXORDER PARM('IMOQ')                                 */
/* ---------------------------------------------------------------- */
             PGM        PARM(&LIB)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSG) TYPE(*CHAR) LEN(512)

/* iMoq and the example source are in &LIB                          */
             CHGCURLIB  CURLIB(&LIB)

/* 1. Create the mocks                                              */
             IMOQPGM    OBJ(EXCUST) PARMS((*CHAR 5) (*CHAR 30) (*IND))
             IMOQSRVPGM OBJ(EXLOCK)
             IMOQPROC   OBJ(EXLOCK) PROC(EX_LOCK) PARMS((*CHAR 5 *CONST))
             IMOQPROC   OBJ(EXLOCK) PROC(EX_UNLOCK) +
                          PARMS((*CHAR 5 *CONST))
             IMOQBUILD  OBJ(EXLOCK)

/* 2. Compile the test program                                      */
             CRTRPGMOD  MODULE(QTEMP/EXORDER_T) SRCFILE(&LIB/QRPGLESRC)
             CRTPGM     PGM(QTEMP/EXORDER_T) MODULE(QTEMP/EXORDER_T) +
                          BNDSRVPGM((*LIBL/EXLOCK) (*LIBL/IMOQENG)) +
                          ACTGRP(*NEW)

/* 3. Run it. A failed expect() arrives as escape message CPF9898.  */
             CALL       PGM(QTEMP/EXORDER_T)
             MONMSG     MSGID(CPF9898) EXEC(DO)
             RCVMSG     MSGTYPE(*EXCP) MSG(&MSG)
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA('EXORDER +
                          failed:' *BCAT &MSG) MSGTYPE(*ESCAPE)
             ENDDO

/* 4. Remove the mocks                                              */
             IMOQRMV
             SNDPGMMSG  MSGID(CPF9897) MSGF(QCPFMSG) MSGDTA('EXORDER +
                          passed') MSGTYPE(*COMP)
             ENDPGM
