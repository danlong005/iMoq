/* ---------------------------------------------------------------- */
/* BUILD - build iMoq from a copy of the imoq repository            */
/*                                                                  */
/* 1. Put the repository in the IFS, for example:                   */
/*      git clone <repo url> /home/ME/imoq                          */
/* 2. Compile this program straight from the IFS:                   */
/*      CRTBNDCL PGM(QTEMP/BUILD)                                   */
/*        SRCSTMF('/home/ME/imoq/QCLLESRC/BUILD.clle')              */
/* 3. Run it:                                                       */
/*      CALL QTEMP/BUILD PARM('IMOQ' '/home/ME/imoq')               */
/*    or, for a path longer than 32 characters:                     */
/*      CHGCURDIR DIR('/a/long/path/to/imoq')                       */
/*      CALL QTEMP/BUILD PARM('IMOQ' '*CURDIR' '*YES')              */
/*                                                                  */
/* Parameters                                                       */
/*   1  Library to build into. Created if it does not exist.        */
/*   2  IFS directory holding the repository, or *CURDIR (default). */
/*      A quoted CALL parameter is only reliable up to 32            */
/*      characters; use CHGCURDIR and *CURDIR for longer paths.      */
/*   3  *YES also copies the example code from examples/ and runs   */
/*      the unit tests (IMOQTEST), the demo (IMOQDEMO) and the      */
/*      feature examples (EXAMPLES). Default *NO. The demo and the  */
/*      examples change the current library and library list of the */
/*      job that runs them.                                         */
/*                                                                  */
/* Steps: create the library and the source files QRPGLESRC,        */
/* QCLLESRC, QCMDSRC and QSRVSRC; copy every file in the matching   */
/* repository folder (and examples/ folder with *YES) into a        */
/* member of the same name, the extension becoming the source type; */
/* compile and run IMOQINST, which builds                           */
/* the commands, programs, service program and message file.        */
/* The copy step writes its output to build.log in the directory.   */
/* ---------------------------------------------------------------- */
             PGM        PARM(&LIB &DIR &TESTS)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&DIR) TYPE(*CHAR) LEN(200)
             DCL        VAR(&TESTS) TYPE(*CHAR) LEN(4)
             DCL        VAR(&RUNTESTS) TYPE(*CHAR) LEN(4) VALUE('*NO')
             DCL        VAR(&PATH) TYPE(*CHAR) LEN(200) +
                          VALUE('*CURDIR')
             DCL        VAR(&POS) TYPE(*INT) LEN(4)
             DCL        VAR(&LEN) TYPE(*INT) LEN(4)
             DCL        VAR(&SRCF) TYPE(*CHAR) LEN(10)
             DCL        VAR(&PGM) TYPE(*CHAR) LEN(10)
             DCL        VAR(&SH) TYPE(*CHAR) LEN(2000)
             DCL        VAR(&CMD) TYPE(*CHAR) LEN(200)
             DCL        VAR(&EXDIRS) TYPE(*CHAR) LEN(60)
             DCL        VAR(&MSG) TYPE(*CHAR) LEN(512)
             DCL        VAR(&STEP) TYPE(*CHAR) LEN(60)

             MONMSG     MSGID(CPF0000 MCH0000 QSH0000) +
                          EXEC(GOTO CMDLBL(FAIL))

             CHGVAR     VAR(&STEP) VALUE('checking parameters')
             CHGVAR     VAR(&RUNTESTS) VALUE(&TESTS)
             MONMSG     MSGID(MCH3601)
             IF         COND(&LIB *EQ ' ') THEN(DO)
             CHGVAR     VAR(&MSG) VALUE('Usage: CALL BUILD PARM(''LIB'' +
                          ''/ifs/path/imoq''|''*CURDIR'' +
                          [''*YES''])')
             GOTO       CMDLBL(FAIL2)
             ENDDO
/* The path ends at its first blank (CALL pads short values to 32)  */
             CHGVAR     VAR(&PATH) VALUE(&DIR)
             MONMSG     MSGID(MCH3601)
             CHGVAR     VAR(&POS) VALUE(%SCAN(' ' &PATH))
             CHGVAR     VAR(&LEN) VALUE(&POS - 1)
             IF         COND(&POS *GT 1) THEN(CHGVAR VAR(&PATH) +
                          VALUE(%SST(&PATH 1 &LEN)))
             IF         COND(&POS *EQ 1) THEN(CHGVAR VAR(&PATH) +
                          VALUE('*CURDIR'))
             IF         COND(&PATH *EQ '*CURDIR') THEN(CHGVAR +
                          VAR(&PATH) VALUE('.'))

/* ---- library and source files ---------------------------------- */
             CHGVAR     VAR(&STEP) VALUE('creating library' *BCAT &LIB)
             CHKOBJ     OBJ(QSYS/&LIB) OBJTYPE(*LIB)
             MONMSG     MSGID(CPF9801) EXEC(DO)
/* run through QCMDEXC so BUILD compiles for users without CRTLIB   */
             CHGVAR     VAR(&CMD) VALUE('CRTLIB LIB(' *CAT %TRIMR(&LIB) +
                          *TCAT ') TEXT(''iMoq mocking framework'')')
             CALL       PGM(QCMDEXC) PARM(&CMD 200)
             ENDDO

             CHGVAR     VAR(&SRCF) VALUE('QRPGLESRC')
             CALLSUBR   SUBR(SRCFILE)
             CHGVAR     VAR(&SRCF) VALUE('QCLLESRC')
             CALLSUBR   SUBR(SRCFILE)
             CHGVAR     VAR(&SRCF) VALUE('QCMDSRC')
             CALLSUBR   SUBR(SRCFILE)
             CHGVAR     VAR(&SRCF) VALUE('QSRVSRC')
             CALLSUBR   SUBR(SRCFILE)

/* ---- copy the repository folders into source members ----------- */
/* Each file becomes a member named after the file (upper case)     */
/* with the extension as source type: IMOQENG.sqlrpgle -> IMOQENG   */
/* SQLRPGLE. Qshell stops at the first file that fails to copy.     */
/* The examples (used by IMOQDEMO) are copied only with *YES        */
             IF         COND(&RUNTESTS *EQ '*YES') THEN(CHGVAR +
                          VAR(&EXDIRS) VALUE('examples/QRPGLESRC +
                          examples/QCLLESRC examples/QSRVSRC'))
             CHGVAR     VAR(&STEP) VALUE('copying source from' *BCAT +
                          &PATH)
             ADDENVVAR  ENVVAR(QIBM_QSH_CMD_ESCAPE_MSG) VALUE(Y) +
                          REPLACE(*YES)
             ADDENVVAR  ENVVAR(QIBM_QSH_CMD_OUTPUT) VALUE(NONE) +
                          REPLACE(*YES)

             CHGVAR     VAR(&SH) VALUE('cd ''' *CAT %TRIMR(&PATH) +
                          *TCAT ''' || exit 1; +
                          rm -f build.log; touch -C 819 build.log; +
                          ( for d in QRPGLESRC QCLLESRC QCMDSRC +
                          QSRVSRC ' *CAT &EXDIRS *TCAT '; do +
                          s=$(basename $d); for f in $d/*.*; do +
                          test -f "$f" || continue; +
                          m=$(basename "${f%.*}" | tr a-z A-Z); +
                          t=$(echo "${f##*.}" | tr a-z A-Z); +
                          echo "$d/$m ($t)"; +
                          system "ADDPFM FILE(' *CAT %TRIMR(&LIB) +
                          *TCAT '/$s) MBR($m) SRCTYPE($t)" +
                          >/dev/null 2>&1; +
                          system "CPYFRMSTMF FROMSTMF(''$PWD/$f'') +
                          TOMBR(''/QSYS.LIB/' *CAT %TRIMR(&LIB) +
                          *TCAT '.LIB/$s.FILE/$m.MBR'') +
                          MBROPT(*REPLACE) STMFCCSID(1208) +
                          DBFCCSID(*FILE)" || exit 1; +
                          system "CHGPFM FILE(' *CAT %TRIMR(&LIB) +
                          *TCAT '/$s) MBR($m) SRCTYPE($t)" +
                          >/dev/null 2>&1; +
                          done; done ) >> build.log 2>&1')
             QSH        CMD(&SH)

             RMVENVVAR  ENVVAR(QIBM_QSH_CMD_OUTPUT)
             MONMSG     MSGID(CPF0000)
             RMVENVVAR  ENVVAR(QIBM_QSH_CMD_ESCAPE_MSG)
             MONMSG     MSGID(CPF0000)

/* ---- compile and run the installer ----------------------------- */
             CHGVAR     VAR(&STEP) VALUE('compiling IMOQINST')
             CRTBNDCL   PGM(&LIB/IMOQINST) SRCFILE(&LIB/QCLLESRC) +
                          SRCMBR(IMOQINST) REPLACE(*YES)
             CHGVAR     VAR(&STEP) VALUE('running IMOQINST')
             CALL       PGM(&LIB/IMOQINST) PARM(&LIB &LIB)

/* ---- optional self-tests --------------------------------------- */
/* Compiling the tests needs the iMoq commands in the library list   */
             IF         COND(&RUNTESTS *EQ '*YES') THEN(DO)
             ADDLIBLE   LIB(&LIB) POSITION(*LAST)
             MONMSG     MSGID(CPF2103)
             CHGVAR     VAR(&PGM) VALUE('IMOQTEST')
             CALLSUBR   SUBR(RUNTEST)
             CHGVAR     VAR(&PGM) VALUE('IMOQDEMO')
             CALLSUBR   SUBR(RUNTEST)
             CHGVAR     VAR(&STEP) VALUE('compiling EXAMPLES')
             CRTBNDCL   PGM(&LIB/EXAMPLES) SRCFILE(&LIB/QCLLESRC) +
                          SRCMBR(EXAMPLES) REPLACE(*YES)
             CHGVAR     VAR(&STEP) VALUE('running EXAMPLES')
             CALL       PGM(&LIB/EXAMPLES) PARM(&LIB)
             ENDDO

             CHGVAR     VAR(&MSG) VALUE('iMoq built in library' +
                          *BCAT &LIB)
             SNDPGMMSG  MSGID(CPF9897) MSGF(QCPFMSG) MSGDTA(&MSG) +
                          MSGTYPE(*COMP)
             RETURN

 FAIL:       RCVMSG     MSGTYPE(*EXCP) RMV(*NO) MSG(&MSG)
             MONMSG     MSGID(CPF0000)
             RMVENVVAR  ENVVAR(QIBM_QSH_CMD_OUTPUT)
             MONMSG     MSGID(CPF0000)
             RMVENVVAR  ENVVAR(QIBM_QSH_CMD_ESCAPE_MSG)
             MONMSG     MSGID(CPF0000)
             CHGVAR     VAR(&MSG) VALUE('BUILD failed while' *BCAT +
                          &STEP *TCAT ':' *BCAT &MSG)
 FAIL2:      SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&MSG) +
                          MSGTYPE(*ESCAPE)
             MONMSG     MSGID(CPF0000)
             RETURN

/* ---- create one source file (kept if it already exists) -------- */
             SUBR       SUBR(SRCFILE)
             CHGVAR     VAR(&STEP) VALUE('creating source file' *BCAT +
                          &SRCF)
             CRTSRCPF   FILE(&LIB/&SRCF) RCDLEN(112)
             MONMSG     MSGID(CPF7302)
             ENDSUBR

/* ---- compile and run one self-test driver ---------------------- */
             SUBR       SUBR(RUNTEST)
             CHGVAR     VAR(&STEP) VALUE('compiling' *BCAT &PGM)
             CRTBNDCL   PGM(&LIB/&PGM) SRCFILE(&LIB/QCLLESRC) +
                          SRCMBR(&PGM) REPLACE(*YES)
             CHGVAR     VAR(&STEP) VALUE('running' *BCAT &PGM)
             CALL       PGM(&LIB/&PGM) PARM(&LIB &LIB)
             ENDSUBR
             ENDPGM
