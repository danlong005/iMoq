**free
// ------------------------------------------------------------------
// IMOQENG_H - iMoq engine internals (templates + prototypes)
// Used by the IMOQENG service program modules and its unit tests.
// Test authors should /copy IMOQ_H instead.
// ------------------------------------------------------------------
/if defined(IMOQENG_H)
/eof
/endif
/define IMOQENG_H

dcl-c IMOQ_MAXP 64;

// Parameter / return value layout
dcl-ds imoq_def_t qualified template;
  type char(10);
  len int(10);
  dec int(10);
  passing char(6);
end-ds;

// Error returned to the CL command processing programs
dcl-ds imoq_err_t qualified template;
  msgId char(7);
  msgfLib char(10);
  text char(512);
end-ds;

// Escape message a stub must send to its caller
dcl-ds imoq_throw_t qualified template;
  msgId char(7);
  msgf char(10);
  msgfLib char(10);
  msgDta varchar(512);
end-ds;

// Argument matcher: ARGS((parmNo[.field] matcher value)).
// field is blank for the whole parameter, else a subfield declared
// with IMOQFIELD: NAME, or NAME(n) for an array element.
dcl-ds imoq_matcher_t qualified template;
  parmNo int(10);
  matcher char(10);
  val varchar(1024);
  field varchar(40);
end-ds;

// A complete stub (IMOQWHEN), as saved by imoq_stubSave
dcl-ds imoq_stub_t qualified template;
  id int(10);
  obj char(10);
  proc varchar(4096);
  nM int(10);
  m likeds(imoq_matcher_t) dim(64);
  nRtn int(10);
  rtn varchar(1024) dim(32);
  nSet int(10);
  setNo int(10) dim(64);
  setVal varchar(1024) dim(64);
  setFld varchar(40) dim(64);
  thrId char(7);
  thrMsgf char(10);
  thrLib char(10);
  thrDta varchar(512);
  times int(10);
end-ds;

// ---- Stub entry point (called by generated stubs) ----------------
dcl-pr imoq_invoke int(10) extproc('IMOQ_INVOKE');
  obj char(10) const;
  proc varchar(4096) const;
  parmCount int(10) value;
  parmPtrs pointer value;
  rtnPtr pointer value;
  thr likeds(imoq_throw_t);
end-pr;

// ---- Codec (IMOQCDC) ---------------------------------------------
dcl-pr imoq_normDef ind extproc('IMOQ_NORMDEF');
  def likeds(imoq_def_t);
  msg varchar(256);
end-pr;

dcl-pr imoq_decode varchar(1024) extproc('IMOQ_DECODE');
  ptr pointer value;
  def likeds(imoq_def_t) const;
end-pr;

dcl-pr imoq_encode ind extproc('IMOQ_ENCODE');
  ptr pointer value;
  def likeds(imoq_def_t) const;
  text varchar(1024) const;
  msg varchar(256);
end-pr;

dcl-pr imoq_match ind extproc('IMOQ_MATCH');
  matcher char(10) const;
  expected varchar(1024) const;
  state char(1) const;
  actual varchar(1024) const;
  def likeds(imoq_def_t) const;
end-pr;

dcl-pr imoq_byteSize int(10) extproc('IMOQ_BYTESIZE');
  def likeds(imoq_def_t) const;
end-pr;

dcl-pr imoq_isNumeric ind extproc('IMOQ_ISNUMERIC');
  type char(10) const;
end-pr;

dcl-pr imoq_rpgType varchar(64) extproc('IMOQ_RPGTYPE');
  def likeds(imoq_def_t) const;
end-pr;

dcl-pr imoq_validMatcher ind extproc('IMOQ_VALIDMATCHER');
  matcher char(10) const;
end-pr;

// Items of a *IN or *BETWEEN value (comma-separated, trimmed)
dcl-pr imoq_splitList int(10) extproc('IMOQ_SPLITLIST');
  text varchar(1024) const;
  items varchar(1024) dim(64);
end-pr;

// ---- Source generation (IMOQGEN) ---------------------------------
dcl-pr imoq_genPgm ind extproc('IMOQ_GENPGM');
  obj char(10) const;
  parmCount int(10) value;
  msg varchar(512);
end-pr;

dcl-pr imoq_genSrv ind extproc('IMOQ_GENSRV');
  obj char(10) const;
  msg varchar(512);
end-pr;

dcl-pr imoq_readExports ind extproc('IMOQ_READEXPORTS');
  obj char(10) const;
  names varchar(4096) dim(2000);
  count int(10);
  msg varchar(512);
end-pr;

// ---- Engine core (IMOQENG), shared by the commands and IMOQAPI ---
// Validate a stub and save it: id 0 adds a new stub and sets id,
// an existing id replaces that stub's definition
dcl-pr imoq_stubSave ind extproc('IMOQ_STUBSAVE');
  stub likeds(imoq_stub_t);
  err likeds(imoq_err_t);
end-pr;

dcl-pr imoq_stubLoad ind extproc('IMOQ_STUBLOAD');
  id int(10) const;
  stub likeds(imoq_stub_t);
  err likeds(imoq_err_t);
end-pr;

// Mock and procedure exist; procOut is the name as the mock exports it
dcl-pr imoq_resolveTarget ind extproc('IMOQ_RESOLVETARGET');
  obj char(10) const;
  procIn varchar(4096) const;
  procOut varchar(4096);
  err likeds(imoq_err_t);
end-pr;

// Validate one matcher for obj/proc (uppercases m.matcher)
dcl-pr imoq_checkMatcher ind extproc('IMOQ_CHECKMATCHER');
  obj char(10) const;
  proc varchar(4096) const;
  m likeds(imoq_matcher_t);
  what varchar(40) const;
  err likeds(imoq_err_t);
end-pr;

// Count the recorded calls that match; mode *EXACTLY, *ATLEAST,
// *ATMOST, *ONCE or *NEVER verifies (IMQ0200 on failure), *COUNT
// only counts
dcl-pr imoq_verifyCalls ind extproc('IMOQ_VERIFYCALLS');
  obj char(10) const;
  procIn varchar(4096) const;
  m likeds(imoq_matcher_t) dim(64) const;
  nM int(10) const;
  mode char(9) const;
  want int(10) const;
  count int(10);
  err likeds(imoq_err_t);
end-pr;

// A matching call came after the one the previous order check
// matched (IMQ0200 on failure); fromStart searches all calls
dcl-pr imoq_verifyOrder ind extproc('IMOQ_VERIFYORDER');
  obj char(10) const;
  procIn varchar(4096) const;
  m likeds(imoq_matcher_t) dim(64) const;
  nM int(10) const;
  fromStart ind const;
  err likeds(imoq_err_t);
end-pr;

dcl-pr imoq_getArg ind extproc('IMOQ_GETARG');
  obj char(10) const;
  procIn varchar(4096) const;
  callNo int(10) const;
  parmNo int(10) const;
  field varchar(40) const;
  val varchar(1024);
  err likeds(imoq_err_t);
end-pr;

// Parse a subfield reference: NAME, or NAME(i) for an array element.
// field comes back uppercase without blanks; blank text is valid and
// means the whole parameter.
dcl-pr imoq_parseField ind extproc('IMOQ_PARSEFIELD');
  text varchar(64) const;
  field varchar(40);
  msg varchar(256);
end-pr;

dcl-pr imoq_cl_noMore extproc('IMOQ_CL_NOMORE');
  obj char(10) const;
  err likeds(imoq_err_t);
end-pr;

dcl-pr imoq_cl_unused extproc('IMOQ_CL_UNUSED');
  obj char(10) const;
  err likeds(imoq_err_t);
end-pr;

dcl-pr imoq_cl_reset extproc('IMOQ_CL_RESET');
  obj char(10) const;
  scope char(7) const;
  err likeds(imoq_err_t);
end-pr;

dcl-pr imoq_setLastError extproc('IMOQ_SETLASTERROR');
  text varchar(512) const;
end-pr;

// ---- RPG API (IMOQAPI) internals, exported for the unit tests -----
dcl-pr imoq_numText varchar(64) extproc('IMOQ_NUMTEXT');
  value packed(31:9) const;
end-pr;

// ---- Public API for test programs (also in IMOQ_H) ---------------
dcl-pr imoq_run extproc('IMOQ_RUN');
  cmd varchar(3000) const;
end-pr;

dcl-pr imoq_ok ind extproc('IMOQ_OK');
  cmd varchar(3000) const;
end-pr;

dcl-pr imoq_lastError varchar(512) extproc('IMOQ_LASTERROR') end-pr;

dcl-pr imoq_arg varchar(1024) extproc('IMOQ_ARG');
  obj char(10) const;
  proc varchar(4096) const;
  callNo int(10) const;
  parmNo int(10) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_count int(10) extproc('IMOQ_COUNT');
  obj char(10) const;
  proc varchar(4096) const;
end-pr;

dcl-pr imoq_startOrder extproc('IMOQ_STARTORDER') end-pr;
