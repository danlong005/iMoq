**free
// ------------------------------------------------------------------
// IMOQ_H - iMoq API for test programs (RPGUnit or plain RPG)
//
//   Bind with service program IMOQENG (BNDSRVPGM or a binding dir).
//
//   imoq('IMOQWHEN OBJ(TAXSRV) PROC(CALCTAX) RETURN(''6.00'')');
//   assert(imoq_ok('IMOQVERIFY OBJ(TAXSRV) PROC(CALCTAX) +
//          TIMES(*ONCE)') : imoq_lastError());
// ------------------------------------------------------------------
/if defined(IMOQ_H)
/eof
/endif
/define IMOQ_H

// Run any IMOQ* command. Sends escape message IMQ0300 if it fails.
dcl-pr imoq extproc('IMOQ_RUN');
  cmd varchar(3000) const;
end-pr;

// Run any IMOQ* command. Returns *off if it failed (for assertions).
dcl-pr imoq_ok ind extproc('IMOQ_OK');
  cmd varchar(3000) const;
end-pr;

// Text of the last failure (verification message, strict-mock call...)
dcl-pr imoq_lastError varchar(512) extproc('IMOQ_LASTERROR') end-pr;

// Captured argument as text: callNo 1..n or IMOQ_LAST, parmNo 1..64,
// field a subfield declared with IMOQFIELD (NAME, or NAME(i)).
// Returns *OMIT / *NOTPASSED for missing arguments.
dcl-pr imoq_arg varchar(1024) extproc('IMOQ_ARG');
  obj char(10) const;
  proc varchar(4096) const;
  callNo int(10) const;
  parmNo int(10) const;
  field varchar(40) const options(*nopass);
end-pr;

// Number of recorded calls (-1 if the mock or procedure is unknown)
dcl-pr imoq_count int(10) extproc('IMOQ_COUNT');
  obj char(10) const;
  proc varchar(4096) const;
end-pr;

dcl-c IMOQ_LAST -1;
dcl-c IMOQ_PGM '*PGM';

// ==================================================================
// RPG API: stubs and verifications built from handles. No command
// strings, no quoting. imoq_with, imoq_returns and imoq_setParm use
// OVERLOAD (IBM i 7.4 TR5 or later); on an older compiler,
// /define IMOQ_NO_OVERLOAD before the /copy and call the typed
// procedures (imoq_withChar, imoq_withNum ...) directly.
//
//   h = imoq_when('TAXSRV' : 'CALCTAX');
//   imoq_with(h : 1 : IMOQ_EQ : 100);
//   imoq_returns(h : 6.00);
//
//   v = imoq_verify('TAXSRV' : 'CALCTAX');
//   imoq_with(v : 1 : IMOQ_EQ : 100);
//   assert(imoq_calledOnce(v) : imoq_lastError());
//
// Setup calls send escape IMQ0300 when they fail. Checks return
// *off and leave the reason in imoq_lastError().
// ==================================================================

// Matchers (imoq_with)
dcl-c IMOQ_EQ '*EQ';
dcl-c IMOQ_NE '*NE';
dcl-c IMOQ_GT '*GT';
dcl-c IMOQ_GE '*GE';
dcl-c IMOQ_LT '*LT';
dcl-c IMOQ_LE '*LE';
dcl-c IMOQ_LIKE '*LIKE';
dcl-c IMOQ_ANY '*ANY';
dcl-c IMOQ_BLANK '*BLANK';
dcl-c IMOQ_OMIT '*OMIT';
dcl-c IMOQ_NOTPASSED '*NOTPASSED';
dcl-c IMOQ_IN '*IN';             // 'PA,NJ,NY': one of the values
dcl-c IMOQ_BETWEEN '*BETWEEN';   // '10,20': low to high, both included

dcl-c IMOQ_MOCK '*MOCK';     // imoq_throws: message IMQ0101
dcl-c IMOQ_ALWAYS -1;        // imoq_times: answer every call
dcl-c IMOQ_ALL '*ALL';       // imoq_reset scopes
dcl-c IMOQ_CALLS '*CALLS';
dcl-c IMOQ_STUBS '*STUBS';

// ---- Stubbing ----------------------------------------------------
// Start a stub; returns its handle. Omit proc for a program mock.
dcl-pr imoq_when int(10) extproc('IMOQ_WHEN');
  obj char(10) const;
  proc varchar(4096) const options(*nopass);
end-pr;

// Add an argument matcher to a stub or a verification.
// IMOQ_ANY, IMOQ_BLANK, IMOQ_OMIT and IMOQ_NOTPASSED take no value.
// field matches a subfield declared with IMOQFIELD instead of the
// whole parameter: NAME, or NAME(i) for an array element.
dcl-pr imoq_withChar extproc('IMOQ_WITHCHAR');
  h int(10) const;
  parmNo int(10) const;
  matcher char(10) const;
  value varchar(1024) const options(*nopass);
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_withNum extproc('IMOQ_WITHNUM');
  h int(10) const;
  parmNo int(10) const;
  matcher char(10) const;
  value packed(31:9) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_withDate extproc('IMOQ_WITHDATE');
  h int(10) const;
  parmNo int(10) const;
  matcher char(10) const;
  value date(*iso) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_withTime extproc('IMOQ_WITHTIME');
  h int(10) const;
  parmNo int(10) const;
  matcher char(10) const;
  value time(*iso) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_withTimestamp extproc('IMOQ_WITHTIMESTAMP');
  h int(10) const;
  parmNo int(10) const;
  matcher char(10) const;
  value timestamp const;
  field varchar(40) const options(*nopass);
end-pr;

/if not defined(IMOQ_NO_OVERLOAD)
dcl-pr imoq_with overload(imoq_withChar : imoq_withNum : imoq_withDate
                          : imoq_withTime : imoq_withTimestamp);
/endif

// Start an alternative (OR). The imoq_with calls after it form a new
// group; the stub or verification matches when all of one group's
// matchers match. Matchers added before the first imoq_or must match
// in every case:
//   imoq_with(h : 3 : IMOQ_EQ : 'US');    // always
//   imoq_or(h);
//   imoq_with(h : 1 : IMOQ_EQ : 'PA');    // either this
//   imoq_or(h);
//   imoq_with(h : 2 : IMOQ_GT : 100);     // or this
dcl-pr imoq_or extproc('IMOQ_OR');
  h int(10) const;
end-pr;

// Add a return value. Call it again for a series: one value per
// call, and the last one repeats.
dcl-pr imoq_returnsChar extproc('IMOQ_RETURNSCHAR');
  h int(10) const;
  value varchar(1024) const;
end-pr;

dcl-pr imoq_returnsNum extproc('IMOQ_RETURNSNUM');
  h int(10) const;
  value packed(31:9) const;
end-pr;

dcl-pr imoq_returnsDate extproc('IMOQ_RETURNSDATE');
  h int(10) const;
  value date(*iso) const;
end-pr;

dcl-pr imoq_returnsTime extproc('IMOQ_RETURNSTIME');
  h int(10) const;
  value time(*iso) const;
end-pr;

dcl-pr imoq_returnsTimestamp extproc('IMOQ_RETURNSTIMESTAMP');
  h int(10) const;
  value timestamp const;
end-pr;

/if not defined(IMOQ_NO_OVERLOAD)
dcl-pr imoq_returns overload(imoq_returnsChar : imoq_returnsNum
                             : imoq_returnsDate : imoq_returnsTime
                             : imoq_returnsTimestamp);
/endif

// Fill an output parameter when the stub answers. With field, fill
// one subfield (NAME or NAME(i)); parameter 0 with a field sets a
// subfield of the data structure the procedure returns.
dcl-pr imoq_setParmChar extproc('IMOQ_SETPARMCHAR');
  h int(10) const;
  parmNo int(10) const;
  value varchar(1024) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_setParmNum extproc('IMOQ_SETPARMNUM');
  h int(10) const;
  parmNo int(10) const;
  value packed(31:9) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_setParmDate extproc('IMOQ_SETPARMDATE');
  h int(10) const;
  parmNo int(10) const;
  value date(*iso) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_setParmTime extproc('IMOQ_SETPARMTIME');
  h int(10) const;
  parmNo int(10) const;
  value time(*iso) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_setParmTimestamp extproc('IMOQ_SETPARMTIMESTAMP');
  h int(10) const;
  parmNo int(10) const;
  value timestamp const;
  field varchar(40) const options(*nopass);
end-pr;

/if not defined(IMOQ_NO_OVERLOAD)
dcl-pr imoq_setParm overload(imoq_setParmChar : imoq_setParmNum
                             : imoq_setParmDate : imoq_setParmTime
                             : imoq_setParmTimestamp);
/endif

// Send an escape message instead of answering. IMOQ_MOCK sends
// IMQ0101; any other message ID needs its message file.
dcl-pr imoq_throws extproc('IMOQ_THROWS');
  h int(10) const;
  msgId char(7) const;
  msgDta varchar(512) const options(*nopass);
  msgf char(10) const options(*nopass);
  msgfLib char(10) const options(*nopass);
end-pr;

// Answer only n calls (default IMOQ_ALWAYS)
dcl-pr imoq_times extproc('IMOQ_TIMES');
  h int(10) const;
  n int(10) const;
end-pr;

// Copy an argument, as it arrived, into an output parameter, or into
// the return value (toParm 0). The fields name subfields declared
// with IMOQFIELD (NAME, or NAME(i)).
dcl-pr imoq_copyArg extproc('IMOQ_COPYARG');
  h int(10) const;
  fromParm int(10) const;
  toParm int(10) const;
  fromField varchar(40) const options(*nopass);
  toField varchar(40) const options(*nopass);
end-pr;

// Finish each answer with your own procedure, which takes no
// parameters: imoq_answers(h : %paddr(myAnswer)). It runs after the
// stub's RETURN, SETPARM and COPYARG, and reads and sets the call
// with the imoq_answer... procedures below. *null removes it.
dcl-pr imoq_answers extproc('IMOQ_ANSWERS');
  h int(10) const;
  answer pointer(*proc) const;
end-pr;

// ---- Inside an answer procedure: the call being answered ----------
// Arguments as they arrived. imoq_answerArg returns *OMIT or
// *NOTPASSED for missing ones; the typed getters send IMQ0300.
// A failure in an answer procedure makes the mock end the call with
// escape message IMQ0102.
dcl-pr imoq_answerArg varchar(1024) extproc('IMOQ_ANSWERARG');
  parmNo int(10) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_answerArgNum packed(31:9) extproc('IMOQ_ANSWERARGNUM');
  parmNo int(10) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_answerArgDate date(*iso) extproc('IMOQ_ANSWERARGDATE');
  parmNo int(10) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_answerArgTime time(*iso) extproc('IMOQ_ANSWERARGTIME');
  parmNo int(10) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_answerArgTimestamp timestamp
       extproc('IMOQ_ANSWERARGTIMESTAMP');
  parmNo int(10) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_answerArgInd ind extproc('IMOQ_ANSWERARGIND');
  parmNo int(10) const;
  field varchar(40) const options(*nopass);
end-pr;

// *off when the argument was *OMIT or not passed
dcl-pr imoq_answerArgPassed ind extproc('IMOQ_ANSWERARGPASSED');
  parmNo int(10) const;
  field varchar(40) const options(*nopass);
end-pr;

// Set an output parameter, or with field one of its subfields;
// parameter 0 with a field sets a subfield of the return value
dcl-pr imoq_answerSetParmChar extproc('IMOQ_ANSWERSETPARMCHAR');
  parmNo int(10) const;
  value varchar(1024) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_answerSetParmNum extproc('IMOQ_ANSWERSETPARMNUM');
  parmNo int(10) const;
  value packed(31:9) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_answerSetParmDate extproc('IMOQ_ANSWERSETPARMDATE');
  parmNo int(10) const;
  value date(*iso) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_answerSetParmTime extproc('IMOQ_ANSWERSETPARMTIME');
  parmNo int(10) const;
  value time(*iso) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_answerSetParmTimestamp
       extproc('IMOQ_ANSWERSETPARMTIMESTAMP');
  parmNo int(10) const;
  value timestamp const;
  field varchar(40) const options(*nopass);
end-pr;

/if not defined(IMOQ_NO_OVERLOAD)
dcl-pr imoq_answerSetParm overload(imoq_answerSetParmChar
                                   : imoq_answerSetParmNum
                                   : imoq_answerSetParmDate
                                   : imoq_answerSetParmTime
                                   : imoq_answerSetParmTimestamp);
/endif

// Set the return value
dcl-pr imoq_answerReturnsChar extproc('IMOQ_ANSWERRETURNSCHAR');
  value varchar(1024) const;
end-pr;

dcl-pr imoq_answerReturnsNum extproc('IMOQ_ANSWERRETURNSNUM');
  value packed(31:9) const;
end-pr;

dcl-pr imoq_answerReturnsDate extproc('IMOQ_ANSWERRETURNSDATE');
  value date(*iso) const;
end-pr;

dcl-pr imoq_answerReturnsTime extproc('IMOQ_ANSWERRETURNSTIME');
  value time(*iso) const;
end-pr;

dcl-pr imoq_answerReturnsTimestamp
       extproc('IMOQ_ANSWERRETURNSTIMESTAMP');
  value timestamp const;
end-pr;

/if not defined(IMOQ_NO_OVERLOAD)
dcl-pr imoq_answerReturns overload(imoq_answerReturnsChar
                                   : imoq_answerReturnsNum
                                   : imoq_answerReturnsDate
                                   : imoq_answerReturnsTime
                                   : imoq_answerReturnsTimestamp);
/endif

// ---- Verification ------------------------------------------------
// Start a verification; returns its handle. Add matchers with
// imoq_with, then check. Checks mark the calls they match as
// verified (see imoq_noMoreCalls); imoq_matchCount does not.
dcl-pr imoq_verify int(10) extproc('IMOQ_VERIFY');
  obj char(10) const;
  proc varchar(4096) const options(*nopass);
end-pr;

dcl-pr imoq_calledOnce ind extproc('IMOQ_CALLEDONCE');
  h int(10) const;
end-pr;

dcl-pr imoq_calledTimes ind extproc('IMOQ_CALLEDTIMES');
  h int(10) const;
  n int(10) const;
end-pr;

dcl-pr imoq_calledAtLeast ind extproc('IMOQ_CALLEDATLEAST');
  h int(10) const;
  n int(10) const;
end-pr;

dcl-pr imoq_calledAtMost ind extproc('IMOQ_CALLEDATMOST');
  h int(10) const;
  n int(10) const;
end-pr;

dcl-pr imoq_neverCalled ind extproc('IMOQ_NEVERCALLED');
  h int(10) const;
end-pr;

// Order: *on if a matching call came after the call the previous
// imoq_calledInOrder matched (other calls may come in between).
// imoq_startOrder() begins a new sequence, as does imoq_reset.
dcl-pr imoq_calledInOrder ind extproc('IMOQ_CALLEDINORDER');
  h int(10) const;
end-pr;

dcl-pr imoq_startOrder extproc('IMOQ_STARTORDER') end-pr;

dcl-pr imoq_matchCount int(10) extproc('IMOQ_MATCHCOUNT');
  h int(10) const;
end-pr;

// *on if every recorded call (to obj, or to any mock) was verified
dcl-pr imoq_noMoreCalls ind extproc('IMOQ_NOMORECALLS');
  obj char(10) const options(*nopass);
end-pr;

// *on if every stub (of obj, or of any mock) answered at least one
// call. A stub no call used usually has a wrong matcher.
dcl-pr imoq_noUnusedStubs ind extproc('IMOQ_NOUNUSEDSTUBS');
  obj char(10) const options(*nopass);
end-pr;

// Forget stubs and/or recorded calls (default: everything)
dcl-pr imoq_reset extproc('IMOQ_RESET');
  obj char(10) const options(*nopass);
  scope char(7) const options(*nopass);
end-pr;

// ---- Captured arguments, typed -----------------------------------
// Same arguments as imoq_arg. They send IMQ0300 if the call doesn't
// exist or the value doesn't convert (also for *OMIT/*NOTPASSED).
dcl-pr imoq_argNum packed(31:9) extproc('IMOQ_ARGNUM');
  obj char(10) const;
  proc varchar(4096) const;
  callNo int(10) const;
  parmNo int(10) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_argDate date(*iso) extproc('IMOQ_ARGDATE');
  obj char(10) const;
  proc varchar(4096) const;
  callNo int(10) const;
  parmNo int(10) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_argTime time(*iso) extproc('IMOQ_ARGTIME');
  obj char(10) const;
  proc varchar(4096) const;
  callNo int(10) const;
  parmNo int(10) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_argTimestamp timestamp extproc('IMOQ_ARGTIMESTAMP');
  obj char(10) const;
  proc varchar(4096) const;
  callNo int(10) const;
  parmNo int(10) const;
  field varchar(40) const options(*nopass);
end-pr;

dcl-pr imoq_argInd ind extproc('IMOQ_ARGIND');
  obj char(10) const;
  proc varchar(4096) const;
  callNo int(10) const;
  parmNo int(10) const;
  field varchar(40) const options(*nopass);
end-pr;

// *off when the argument was *OMIT or not passed
dcl-pr imoq_argPassed ind extproc('IMOQ_ARGPASSED');
  obj char(10) const;
  proc varchar(4096) const;
  callNo int(10) const;
  parmNo int(10) const;
  field varchar(40) const options(*nopass);
end-pr;
